# Pterodactyl Panel Configuration
PTERO_PANEL_URL=https://panel.vexanode.gg
PTERO_API_KEY=ptlc_your_client_api_key_here
PTERO_SERVER_ID=your_server_short_identifier

# Optional: Local destination directory to download backup archives
BACKUP_DOWNLOAD_DIR=./backups

# Number of backups to keep on the panel (older ones are pruned automatically)
BACKUP_RETENTION_COUNT=3

# Optional: Discord Webhook URL for status and failure alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
